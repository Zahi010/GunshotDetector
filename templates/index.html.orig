<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <meta name="description" content="Standalone Real-Time Gunshot Sound Detection Application using Google YAMNet Audio AI.">\n    <title>Real-Time Gunshot Sound Detector | YAMNet Deep Learning</title>\n    <link rel="stylesheet" href="/static/css/style.css?v=2">\n</head>\n<body>\n    <div class="container">\n        <!-- Header -->\n        <header class="app-header">\n            <div class="logo-area">\n                <div class="logo-icon" aria-hidden="true">&#9889;</div>\n                <div class="logo-title">\n                    <h1>Real-Time Gunshot Sound Detector</h1>\n                    <span class="badge-tag">YAMNet 1024-d Backbone &bull; 16 kHz Mono &bull; Live Stream</span>\n                </div>\n            </div>\n            <div class="system-status">\n                <span id="modelStatusBadge" class="badge-tag" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.3);">\n                    &#10003; Model Bundle Active\n                </span>\n            </div>\n        </header>\n\n        <!-- Safety Disclaimer Banner -->\n        <aside class="disclaimer-banner" role="alert">\n            <span style="font-size: 20px;">&#9888;</span>\n            <div>\n                <strong>Operational Safety Notice:</strong> This gunshot detector is built for research and evaluation. It is <em>not</em> certified or dependable for life-safety, emergency 911 dispatch, or active tactical defense. Classification is driven by neural network acoustic features, not loudness or volume alone.\n            </div>\n        </aside>\n\n        <!-- Alert Notification Box -->\n        <div id="alertBox" class="alert-box" role="alert">\n            <span id="alertMsg">An error occurred.</span>\n        </div>\n\n        <!-- Mode Selector Navigation Tabs -->\n        <nav class="tabs-nav" aria-label="Detection Modes" style="margin-bottom: 24px;">\n            <button type="button" id="tabLiveBtn" class="tab-btn 
<truncated 18432 of 28324 bytes from the middle of the output>
er">\n                                <label for="mergeWindowSlider">Nearby Event Merge Window:</label>\n                                <span id="mergeWindowValue" class="control-value">1.0s</span>\n                            </div>\n                            <input type="range" id="mergeWindowSlider" min="0.2" max="3.0" step="0.1" value="1.0">\n                        </div>\n\n                        <button type="button" id="runDetectionBtn" class="btn-primary">\n                            Analyze Audio File\n                        </button>\n                    </div>\n                </section>\n\n                <!-- Right: File Results & Waveform -->\n                <section class="card results-card" aria-labelledby="uploadResultsTitle">\n                    <h2 id="uploadResultsTitle" class="card-title">\n                        <span>&#128266;</span> File Analysis Results\n                    </h2>\n\n                    <div id="resultsSection" style="display: none; flex-direction: column; gap: 20px;">\n                        <div id="verdictBanner" class="verdict-banner">\n                            <div class="verdict-text">\n                                <h3 id="verdictTitle" style="font-size: 18px;">Analysis Complete</h3>\n                                <p id="verdictSubtitle">Detection completed.</p>\n                            </div>\n                            <div class="verdict-score">\n                                <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Peak Score</div>\n                                <div id="scoreDisplay" class="score-val">0.000</div>\n                            </div>\n                        </div>\n\n                        <div class="audio-player-box">\n                            <canvas id="waveformCanvas" aria-label="Audio waveform graph with detection highlights"></canvas>\n                            <div class="audio-controls">\n                                <button type="button" id="playPauseBtn" class="play-btn" aria-label="Play or pause audio">\n                                    &#9658;\n                                </button>\n                                <span id="timeDisplay" class="time-display">00:00 / 00:00</span>\n                                <div style="margin-left: auto; font-size: 11px; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">\n                                    <span style="display: inline-block; width: 12px; height: 12px; background: rgba(255, 51, 75, 0.4); border: 1px solid #ff334b; border-radius: 2px;"></span>\n                                    Gunshot Event\n                                </div>\n                            </div>\n                        </div>\n\n                        <div>\n                            <h4 style="font-size: 14px; font-weight: 700; margin-bottom: 8px;">Detected Gunshot Events</h4>\n                            <div class="events-box">\n                                <table class="events-table">\n                                    <thead>\n                                        <tr>\n                                            <th>#</th>\n                                            <th>Timestamp Span</th>\n                                            <th>Peak Time</th>\n                                            <th>Duration</th>\n                                            <th>Peak Score</th>\n                                            <th>Verdict</th>\n                                        </tr>\n                                    </thead>\n                                    <tbody id="eventsTableBody">\n                                        <tr id="noEventsRow">\n                                            <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 18px;">\n                                                No gunshot events detected above the current sensitivity threshold.\n                                            </td>\n                                        </tr>\n                                    </tbody>\n                                </table>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div id="emptyState" style="text-align: center; padding: 48px 20px; color: var(--text-muted);">\n                        <div style="font-size: 42px; margin-bottom: 12px; opacity: 0.5;">&#127911;</div>\n                        <p style="font-size: 14px;">Select an audio recording to visualize waveform and detected gunshot timestamps.</p>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </div>\n\n    <script src="/static/js/app.js?v=2"></script>\n</body>\n</html>